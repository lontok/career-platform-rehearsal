[Unit]
Description=Career Platform FastAPI application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=career-platform
Group=career-platform
WorkingDirectory=/srv/career-platform
EnvironmentFile=/etc/career-platform/environment
ExecStart=/usr/local/bin/uv run --no-sync uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
